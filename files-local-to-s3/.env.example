# =============================================================================
# files-local-to-s3 — folder environment file (template)
# =============================================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored — never commit real tokens/keys.
# Loaded via `import "dotenv/config"` by migrate.js and cleanup-s3.js —
# run them from THIS folder so dotenv finds the .env.
# Full env map: ../ENVIRONMENT.md
# =============================================================================

# Directus instance whose files are being migrated
DIRECTUS_URL=""
# Directus static admin token for that instance
DIRECTUS_TOKEN=""

# Hetzner Object Storage (S3-compatible) credentials
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Hetzner region, e.g. "nbg1"
AWS_REGION=""
# e.g. "https://nbg1.your-objectstorage.com"
S3_ENDPOINT=""
# Target bucket for this environment
S3_BUCKET=""
# Optional key prefix inside the bucket (usually empty)
S3_PREFIX=""
# Directus storage disk name (default "s3")
S3_DISK_NAME="s3"

# Path to the uploads tarball to migrate, relative to this folder
TAR_PATH=""
