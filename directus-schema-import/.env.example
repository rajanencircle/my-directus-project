# =============================================================================
# directus-schema-import — folder environment file (template)
# =============================================================================
# Copy this file to .env and fill in your tokens.
# The .env file is gitignored — never commit real tokens.
# Loaded via require("dotenv").config() by build-apply-json.js, import.js and
# merge-yaml.js — run them from THIS folder so dotenv finds the .env.
# Full env map: ../ENVIRONMENT.md
# =============================================================================

# --- LOCAL (Docker on localhost:8055) ----------------------------------------
DIRECTUS_LOCAL_URL=http://localhost:8055
DIRECTUS_LOCAL_TOKEN=your_local_token_here

# --- STAGING (every direct change must be logged in STAGING_CHANGES/) ---------
DIRECTUS_STAGING_URL=https://staging.content.botg.cloud
DIRECTUS_STAGING_TOKEN=your_staging_token_here

# --- PROD (never touch unless explicitly instructed) ---------------------------
DIRECTUS_PROD_URL=https://your-production-url.com
DIRECTUS_PROD_TOKEN=your_prod_token_here
