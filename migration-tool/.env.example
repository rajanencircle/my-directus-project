# Copy this file to .env in the same directory and fill in real values.
# Never commit the real .env — it holds SSH hosts/keys and DB credentials.
# (Root .gitignore already ignores .env / .env.* everywhere in this repo.)

# ── Where dumps live ──────────────────────────────────────────────────────
# Absolute path to the BOTG/Backup tool's dump output folder. This tool only
# READS dumps from here (produced by running BOTG/Backup/backup/index.js
# separately) and writes its own pre-migration rollback dumps back into the
# same folder/convention. It never runs its own source backups.
BACKUP_ROOT=/Users/rajan/Documents/RAJAN/directus/BOTG/Backup/botg

# ── Remote environments (dev / staging / main) — accessed over SSH ────────
# Same shape as BOTG/Backup/backup/index.js's PROJECTS.botg.environments,
# but sourced from env vars here instead of hardcoded in the script.

DEV_SSH_HOST=
DEV_SSH_PORT=22
DEV_SSH_USER=functional
DEV_SSH_KEY_PATH=/Users/rajan/.ssh/id_ed25519
DEV_DB_CONTAINER=directus-dev-database-1
DEV_DIRECTUS_CONTAINER=directus-dev-directus-1
DEV_DB_USER=directus
DEV_DB_NAME=directus

STAGING_SSH_HOST=
STAGING_SSH_PORT=22
STAGING_SSH_USER=functional
STAGING_SSH_KEY_PATH=/Users/rajan/.ssh/id_ed25519
STAGING_DB_CONTAINER=directus-staging-database-1
STAGING_DIRECTUS_CONTAINER=directus-staging-directus-1
STAGING_DB_USER=directus
STAGING_DB_NAME=directus

MAIN_SSH_HOST=
MAIN_SSH_PORT=22
MAIN_SSH_USER=functional
MAIN_SSH_KEY_PATH=/Users/rajan/.ssh/id_ed25519
MAIN_DB_CONTAINER=directus-main-database-1
MAIN_DIRECTUS_CONTAINER=directus-main-directus-1
MAIN_DB_USER=directus
MAIN_DB_NAME=directus

# ── Local environment — this machine's own directus/docker-compose.yaml ───
# No SSH_* vars: their absence is how transport.js picks the local
# `docker exec` path instead of SSH for this environment.
LOCAL_DB_CONTAINER=directus-cms-template-database-1
LOCAL_DIRECTUS_CONTAINER=directus-cms-template-directus-1
LOCAL_DB_USER=directus
LOCAL_DB_NAME=directus

# ── Dry-run preview: throwaway local Postgres container ───────────────────
DRYRUN_PG_IMAGE=postgres:15-alpine
DRYRUN_PG_PORT=65433
DRYRUN_PG_USER=directus
DRYRUN_PG_PASS=directus
DRYRUN_PG_DB=directus
