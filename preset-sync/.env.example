# Copy this file to .env in the same directory and fill in / adjust as needed.
# Real Directus URLs + tokens are NOT duplicated here — both scripts load them
# straight from the repo root .env (DIRECTUS_LOCAL_URL, DIRECTUS_STAGING_TOKEN, etc).
# This file only holds the task-specific args, so re-runs don't need CLI flags.

# ── Task args (used by both api-copy-preset.js and ssh-copy-preset.js) ────────
SOURCE_ENV=staging
DEST_ENV=staging
SOURCE_PRESET_ID=475
DEST_PRESET_IDS=473,474,476,477,478,479,480,481

# Set to true to actually write. Defaults to false (dry-run / diff-only preview).
APPLY=false

# Required only if DEST_ENV=main — extra guard so `main` is never touched by accident.
CONFIRM_MAIN=false

# ── SSH approach only (ssh-copy-preset.js) ────────────────────────────────────
# Local private key used to SSH into the BOTG servers (matches the key already
# authorized on dev/staging/prod per /Users/rajan/Documents/RAJAN/directus/BOTG/Backup).
SSH_KEY_PATH=/Users/rajan/.ssh/id_ed25519
SSH_USERNAME=functional
