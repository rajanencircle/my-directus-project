# =============================================================================
# BOTG ContentHub — repo-level environment file (template)
# =============================================================================
# Copy to .env and fill in real values. The .env file is gitignored —
# NEVER commit real tokens.
#
# Purpose:
#   - Canonical reference for the per-environment Directus URLs + static tokens.
#   - Consumed by scripts/set-users-language.js (run from the repo root):
#       node --env-file=.env scripts/set-users-language.js
#     (--env-file requires Node >= 20.6)
#
# Folder-specific tooling loads its OWN .env from its folder (dotenv reads CWD):
#   directus/              -> directus/.env              (Docker Compose runtime)
#   directus-schema-import -> directus-schema-import/.env
#   files-local-to-s3/     -> files-local-to-s3/.env
#   files-s3-to-s3/        -> files-s3-to-s3/.env
#   scripts/               -> scripts/.env (via node --env-file=.env)
#
# See ENVIRONMENT.md at the repo root for the full map of env files and keys.
# =============================================================================

# --- LOCAL (Docker on localhost:8055) ----------------------------------------
DIRECTUS_LOCAL_URL="http://localhost:8055"
DIRECTUS_LOCAL_TOKEN="your_local_token_here"

# --- DEV (client dev instance) ------------------------------------------------
DIRECTUS_DEV_URL="https://dev.content.botg.cloud"
DIRECTUS_DEV_TOKEN="your_dev_token_here"

# --- STAGING (every direct change must be logged in STAGING_CHANGES/) ---------
DIRECTUS_STAGING_URL="https://staging.content.botg.cloud"
DIRECTUS_STAGING_TOKEN="your_staging_token_here"

# --- MAIN / PRODUCTION (never touch unless explicitly instructed) --------------
DIRECTUS_MAIN_URL="https://content.botg.cloud"
DIRECTUS_MAIN_TOKEN="your_main_token_here"
