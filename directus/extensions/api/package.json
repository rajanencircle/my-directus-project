{
  "name": "api",
  "description": "Custom REST API layer mounted at /api/v1",
  "icon": "extension",
  "version": "1.0.1",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-endpoint"
  ],
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "api-endpoint",
        "source": "src/hook/index.js"
      },
      {
        "type": "hook",
        "name": "api-auth",
        "source": "src/authHook/index.js"
      }
    ],
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2"
  }
}
