# =============================================================================
# Directus runtime environment (local Docker) — template
# =============================================================================
# Copy to .env and fill in real values. The .env file is gitignored —
# NEVER commit real secrets (DIRECTUS_SECRET, ADMIN_PASSWORD, SMTP creds).
# Auto-loaded by Docker Compose from this directory (docker-compose.yaml
# interpolates ${VAR} from .env). Also grepped by monitor-retention.sh
# for DB_USER / DB_DATABASE — keep the KEY=value format on those lines.
# Full env map: ../ENVIRONMENT.md
# =============================================================================

# --- Database (PostGIS container) --------------------------------------------
DB_USER=directus
DB_PASSWORD=your_db_password_here
DB_DATABASE=directus

# --- Directus core -------------------------------------------------------------
DIRECTUS_PORT=8055
# Generate with e.g.: openssl rand -hex 32
DIRECTUS_SECRET=your_random_secret_here
HOST=0.0.0.0

# --- Cache (Redis container) ---------------------------------------------------
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true

# --- Admin bootstrap account ---------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# --- Public URL & CORS ---------------------------------------------------------
PUBLIC_URL=http://localhost:8055
# CORS: "*" is fine for local development only.
# Production: specify exact origins, e.g. "https://app.domain.com,https://admin.domain.com"
CORS_ENABLED=true
CORS_ORIGIN=*

# --- Cookies -------------------------------------------------------------------
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=localhost

# --- Extensions ------------------------------------------------------------------
EXTENSIONS_PATH=./extensions
EXTENSIONS_AUTO_RELOAD=true
EXTENSIONS_ROLLDOWN=true

# --- Content Security Policy ------------------------------------------------------
CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC=http://localhost:3000,http://localhost:4321,http://localhost:5173,https://*.youtube.com,https://*.vimeo.com,https://*.wistia.net,https://*.loom.com
CONTENT_SECURITY_POLICY_DIRECTIVES__SCRIPT_SRC=array:'self', 'unsafe-eval', https://*.googleapis.com
CONTENT_SECURITY_POLICY_DIRECTIVES__IMG_SRC=array:'self', data:, https://*.gstatic.com, https://*.googleapis.com

# --- Flows & files ------------------------------------------------------------------
FLOWS_EXEC_ALLOWED_MODULES="crypto"
FILE_METADATA_ALLOW_LIST="*"

# --- WebSockets ------------------------------------------------------------------
WEBSOCKETS_ENABLED=true
WEBSOCKETS_REST_AUTH=handshake

# --- Data retention (removes Directus default logs from the DB) --------------------
# NOTE: requires directus_revisions.parent FK = ON DELETE SET NULL (see CLAUDE.md)
RETENTION_ENABLED=true
RETENTION_SCHEDULE="*/5 * * * *"
RETENTION_BATCH=1000
ACTIVITY_RETENTION=10d
REVISIONS_RETENTION=10d
FLOW_LOGS_RETENTION=10d

# --- Assets ------------------------------------------------------------------------
ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=18000

# --- Email (consumed by docker-compose.yaml; optional) ------------------------------
# Uncomment and fill to enable outgoing mail.
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
