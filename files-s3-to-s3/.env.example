# =============================================================================
# files-s3-to-s3 — folder environment file (template)
# =============================================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored — never commit real tokens/keys.
# Loaded via `import "dotenv/config"` by migrate.js and cleanup-s3.js —
# run them from THIS folder so dotenv finds the .env.
# Full env map: ../ENVIRONMENT.md
# =============================================================================

# --- SOURCE ---------------------------------------------------------------------
# NOTE: SRC_DIRECTUS_URL / SRC_DIRECTUS_TOKEN are not read by any code in this
# folder (kept for reference only). The scripts copy bucket -> bucket directly.
SRC_DIRECTUS_URL=""
SRC_DIRECTUS_TOKEN=""
# Bucket to copy FROM
SRC_S3_BUCKET=""
# Optional key prefix inside the source bucket (usually empty)
SRC_S3_PREFIX=""

# --- DESTINATION -----------------------------------------------------------------
# Bucket to copy TO
DST_S3_BUCKET=""
# Optional key prefix inside the destination bucket (usually empty)
DST_S3_PREFIX=""

# --- Shared S3 credentials (Hetzner Object Storage — same account, different buckets)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Hetzner region, e.g. "nbg1"
AWS_REGION=""
# e.g. "https://nbg1.your-objectstorage.com"
S3_ENDPOINT=""
