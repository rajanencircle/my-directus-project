# =============================================================================
# scripts/ — folder environment file (template)
# =============================================================================
# Copy this file to .env and fill in the token.
# The .env file is gitignored — never commit real tokens.
#
# These scripts do NOT use dotenv — load the .env with Node's built-in
# --env-file flag (requires Node >= 20.6), run from THIS folder:
#
#   node --env-file=.env import_geographies_02-07-2026/import-geographies.js --dry-run
#   node --env-file=.env migrate-hotels-mysql.js
#
# Exception: set-users-language.js reads the multi-environment names
# (DIRECTUS_LOCAL_URL, DIRECTUS_STAGING_TOKEN, ...) — run it from the REPO ROOT
# against the root .env instead:
#
#   node --env-file=.env scripts/set-users-language.js
#
# Point DIRECTUS_URL/DIRECTUS_TOKEN at the ONE environment you are working on.
# Full env map: ../ENVIRONMENT.md
# =============================================================================

# --- ACTIVE TARGET -------------------------------------------------------------
DIRECTUS_URL="http://localhost:8055"
DIRECTUS_TOKEN="your_token_here"

# --- Other environments (URLs only — move one up and add its token to switch) ---
# DEV:     https://dev.content.botg.cloud
# STAGING: https://staging.content.botg.cloud   (log changes in STAGING_CHANGES/)
# MAIN:    https://content.botg.cloud           (never touch unless instructed)
